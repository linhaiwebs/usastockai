# Nginx 反向代理配置示例
# 适用于生产环境，让前后端都通过域名访问

# ==========================================
# 方案一：前后端使用同一个域名（推荐）
# ==========================================
# 前端：yourdomain.com
# 后端：yourdomain.com/api/
# 
# ⚠️ 重要：使用Docker容器名称，而不是localhost
# 容器名称格式：${PROJECT_NAME}-frontend 和 ${PROJECT_NAME}-backend
# 例如：PROJECT_NAME=egfjpcom
#   前端容器：egfjpcom-frontend
#   后端容器：egfjpcom-backend

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com;
    
    # 可选：重定向到 HTTPS
    # return 301 https://$server_name$request_uri;
    
    # 后端 API - 优先匹配 /api/ 路径
    location /api/ {
        # 使用Docker容器名称和内部端口
        proxy_pass http://egfjpcom-backend:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # SSE 支持（AI 分析流式响应）
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        chunked_transfer_encoding on;
    }
    
    # 后端文档和健康检查（可选）
    location ~ ^/(docs|redoc|health)$ {
        proxy_pass http://egfjpcom-backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # 前端 - 其他所有路径
    location / {
        # 使用Docker容器名称和内部端口
        proxy_pass http://egfjpcom-frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

