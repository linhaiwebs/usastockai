# ===========================================
# 环境配置文件
# ===========================================

# SiliconFlow AI 配置 [必需]
SILICONFLOW_API_KEY=your_api_key_here

# 后端 API 地址 [必需]
# 浏览器访问的后端地址，用于前端调用
# 开发环境: http://localhost:8000
# 生产环境: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# 前端端口（可选）
# 默认: 3000
# FRONTEND_PORT=3000

# 默认语言（可选）
# 可选: en (英语), ja (日语)
# 默认: en
# DEFAULT_LOCALE=en

# 数据库配置（可选）
# DB_USER=stockai
# DB_PASSWORD=stockai123
# DB_NAME=stockai
