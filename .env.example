# ===========================================
# 环境配置文件
# ===========================================

# ===========================================
# 项目配置（多项目部署时修改）
# ===========================================

# 项目名称（用于容器命名，默认：stockai）
# 多项目部署时设置为不同名称，如：stockai2、stockai-jp等
PROJECT_NAME=stockai

# 网络名称（默认：stockai-network）
# 多项目部署时设置为不同网络名
NETWORK_NAME=stockai-network

# ===========================================
# 必需配置
# ===========================================

# SiliconFlow AI API密钥
SILICONFLOW_API_KEY=your_api_key_here

# ===========================================
# 端口配置（重要！）
# ===========================================

# 前端对外端口（用户访问的端口）
FRONTEND_PORT=3000

# 后端API端口（后端服务监听的端口）
# ⚠️ 重要：前端会调用这个端口访问后端API
BACKEND_PORT=8000

# Redis端口（可选，仅当需要从宿主机访问时配置）
# 默认不暴露，如需外部访问请取消注释并设置不同端口
# REDIS_PORT=6379

# PostgreSQL端口（可选，仅当需要从宿主机访问时配置）
# 默认不暴露，如需外部访问请取消注释并设置不同端口
# DB_PORT=5432

# ===========================================
# API访问配置（重要！）
# ===========================================

# 客户端访问后端API的方式：

# 方式一：同域名不同端口（推荐用于开发/测试环境）
# 不设置 NEXT_PUBLIC_API_URL，前端会自动使用：
# http://当前域名:BACKEND_PORT/api
# 例如：BACKEND_PORT=8000 → http://localhost:8000/api

# 方式二：同域名同端口（nginx反向代理，推荐用于生产环境）
# 设置 BACKEND_PORT=8000（或任何端口），nginx配置：
# location /api/ {
#   proxy_pass http://backend:8000/api/;
# }
# 前端会使用相对路径：/api

# 方式三：完全跨域访问
# 设置 NEXT_PUBLIC_API_URL=https://api.example.com
# 前端会直接访问：https://api.example.com/api

# 跨域API地址（可选，留空则使用同域名访问）
NEXT_PUBLIC_API_URL=

# ===========================================
# 数据库配置（多项目部署时修改）
# ===========================================

# 数据库名称（默认stockai）
DB_NAME=stockai

# 数据库用户名（默认stockai）
DB_USER=stockai

# 数据库密码（默认stockai123，建议修改为强密码）
DB_PASSWORD=stockai123

# ===========================================
# 可选配置
# ===========================================

# 默认语言（en, zh, ja等）
DEFAULT_LOCALE=en

# Finance Query API（股票数据源）
FINANCE_QUERY_URL=https://finance-query.com

# ===========================================
# 多项目部署示例
# ===========================================

# 项目1（默认）：
# PROJECT_NAME=stockai
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# DB_NAME=stockai

# 项目2：
# PROJECT_NAME=egfjpcom
# FRONTEND_PORT=3001
# BACKEND_PORT=8001
# NETWORK_NAME=egfjpcom-network
# DB_NAME=egfjpcom

# ⚠️ 重要提示：
# 修改端口后需要重新构建镜像：
# docker-compose build --no-cache frontend
# docker-compose up -d
