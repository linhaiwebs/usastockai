# ===========================================
# 开发环境配置模板
# ===========================================
# 使用方法：
# 1. 复制此文件为 .env
# 2. 修改必需的配置项
# 3. 运行: docker-compose up -d
# ===========================================

# ===========================================
# 数据库配置
# ===========================================
DB_USER=stockai
DB_PASSWORD=stockai123  # 生产环境请修改为强密码
DB_NAME=stockai

# ===========================================
# SiliconFlow AI 配置 [必需]
# ===========================================
SILICONFLOW_API_KEY=your_api_key_here  # [必需] 请填入您的 API Key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===========================================
# 前端配置 [必需]
# ===========================================
# 客户端访问后端 API 的地址
# 开发环境：http://localhost:8000
# 生产环境：https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# 默认语言（en 或 ja）
DEFAULT_LOCALE=en

# ===========================================
# 端口配置（可选）
# ===========================================
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432
FINANCE_QUERY_PORT=8002
REDIS_PORT=6379

# ===========================================
# 性能配置（可选）
# ===========================================
RATE_LIMIT=120

# ===========================================
# 生产环境注意事项
# ===========================================
# 生产环境请使用 docker-compose.prod.yml
# 并参考 .env.production 和 PRODUCTION_DEPLOYMENT.md
