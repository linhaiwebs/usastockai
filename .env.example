# ===========================================
# 环境配置文件
# ===========================================

# ===========================================
# 必需配置
# ===========================================

# SiliconFlow AI API密钥
SILICONFLOW_API_KEY=your_api_key_here

# 后端 API 地址（浏览器访问）
# 开发环境: http://localhost:8000
# 生产环境: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI模型配置（可选）
# 默认使用 Qwen/Qwen2.5-7B-Instruct（免费，快速）
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# ===========================================
# 多项目部署配置（避免端口冲突）
# ===========================================

# 后端服务端口（默认8000，多项目部署时修改）
# BACKEND_PORT=8000

# 前端服务端口（默认3000，多项目部署时修改）
# FRONTEND_PORT=3000

# 数据库名称（默认stockai，多项目部署时修改）
# DB_NAME=stockai

# 数据库用户名（默认stockai）
# DB_USER=stockai

# 数据库密码（默认stockai123）
# DB_PASSWORD=stockai123

# ===========================================
# 可选配置
# ===========================================

# 默认语言（en 或 ja）
# DEFAULT_LOCALE=en

# Finance Query API（股票数据源）
# FINANCE_QUERY_URL=https://finance-query.com

