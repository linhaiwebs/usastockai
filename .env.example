# ===========================================
# 环境配置文件
# ===========================================

# ===========================================
# 项目配置（多项目部署时修改）
# ===========================================

# 项目名称（用于容器命名，默认：stockai）
# 多项目部署时设置为不同名称，如：stockai2、stockai-jp等
PROJECT_NAME=stockai

# 网络名称（默认：stockai-network）
# 多项目部署时设置为不同网络名
NETWORK_NAME=stockai-network

# ===========================================
# 必需配置
# ===========================================

# SiliconFlow AI API密钥
SILICONFLOW_API_KEY=your_api_key_here

# 后端 API 地址配置
# 有两种部署方式：

# 方式一：同域名部署（推荐）
# 前后端使用同一个域名，通过nginx反向代理区分
# 例如：yourdomain.com (前端) 和 yourdomain.com/api/ (后端)
# 此时不设置 NEXT_PUBLIC_API_URL，前端会自动使用相对路径
# NEXT_PUBLIC_API_URL=

# 方式二：跨域部署
# 前后端使用不同的域名或端口
# 例如：yourdomain.com (前端) 和 api.yourdomain.com (后端)
# 此时需要设置完整的后端地址
# NEXT_PUBLIC_API_URL=http://localhost:8000
# 生产环境：NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# AI模型配置（可选）
# 默认使用 Qwen/Qwen2.5-7B-Instruct（免费，快速）
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# ===========================================
# 端口配置（多项目部署时修改避免冲突）
# ===========================================

# 后端服务端口（默认8000）
BACKEND_PORT=8000

# 前端服务端口（默认3000）
FRONTEND_PORT=3000

# 注意：使用跨域部署时，修改后端端口后，NEXT_PUBLIC_API_URL也需要相应修改
# 例如：BACKEND_PORT=9000
# 则：NEXT_PUBLIC_API_URL=http://localhost:9000

# ===========================================
# 数据库配置（多项目部署时修改）
# ===========================================

# 数据库名称（默认stockai）
DB_NAME=stockai

# 数据库用户名（默认stockai）
DB_USER=stockai

# 数据库密码（默认stockai123，建议修改为强密码）
DB_PASSWORD=stockai123

# ===========================================
# 可选配置
# ===========================================

# 默认语言（en 或 ja）
DEFAULT_LOCALE=en

# Finance Query API（股票数据源）
FINANCE_QUERY_URL=https://finance-query.com
