# ===========================================
# 环境配置文件
# ===========================================

# ===========================================
# 基础配置 [必需]
# ===========================================

# SiliconFlow AI 配置 [必需]
SILICONFLOW_API_KEY=your_api_key_here

# 后端 API 地址 [必需]
# 浏览器访问的后端地址，用于前端调用
# 开发环境: http://localhost:8000
# 生产环境: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# 端口配置 [可选]
# ===========================================

# 后端服务端口
# 默认: 8000
# BACKEND_PORT=8000

# 前端端口
# 默认: 3000
# FRONTEND_PORT=3000

# 数据库端口
# 默认: 5432
# DB_PORT=5432

# ===========================================
# 数据库配置 [可选]
# ===========================================

# 数据库用户名
# 默认: stockai
# DB_USER=stockai

# 数据库密码
# 默认: stockai123
# DB_PASSWORD=stockai123

# 数据库名称
# 默认: stockai
# DB_NAME=stockai

# ===========================================
# AI 服务配置 [可选]
# ===========================================

# SiliconFlow API 基础URL
# 默认: https://api.siliconflow.cn/v1
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# SiliconFlow 模型
# 默认: deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B

# ===========================================
# Finance Query API 配置 [可选]
# ===========================================

# Finance Query 服务主机
# 可以是主机名或完整URL
# 托管服务: https://finance-query.com
# 本地部署: finance-query
# FINANCE_QUERY_HOST=https://finance-query.com

# Finance Query 服务端口
# 默认: 443 (HTTPS) 或 8000 (本地部署)
# FINANCE_QUERY_PORT=443

# 是否使用 HTTPS
# 默认: true (托管服务) 或 false (本地部署)
# FINANCE_QUERY_USE_HTTPS=true

# ===========================================
# 应用配置 [可选]
# ===========================================

# 默认语言
# 可选: en (英语), ja (日语)
# 默认: en
# DEFAULT_LOCALE=en

# 运行环境
# 可选: development, production
# 默认: production
# ENVIRONMENT=production

# 调试模式
# 默认: false
# DEBUG=false
